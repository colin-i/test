BuildRequires:  ant
BuildRequires:  desktop-file-utils
BuildRequires:  java-devel >= 1.8
BuildRequires:  javassist
BuildRequires:  jna
BuildRequires:  jna-contrib

Requires:       actionswf
Requires:       java >= 1.8
Requires:       javassist
Requires:       jna
Requires:       jna-contrib

BuildArch:      noarch

%description
GUI to make .swf files with actionswf.

%prep
%autosetup
# Reuse the distro-style manifest (library jars in /usr/share/java)
cp MANIFEST.f.MF MANIFEST.MF

%build
mkdir libs
ln -s %{_javadir}/jna.jar libs/jna.jar
ln -s %{_javadir}/jna-platform.jar libs/jna-platform.jar
ln -s %{_javadir}/javassist.jar libs/javassist.jar
ant -Djava.lib=$PWD/libs build

%install
install -d %{buildroot}%{_bindir}
install -d %{buildroot}%{_javadir}
install -d %{buildroot}%{_datadir}/pixmaps
install -d %{buildroot}%{_datadir}/applications

# jar
install -m 644 dist/flashalizer.jar %{buildroot}%{_javadir}/%{name}.jar

# wrapper script with JVM options
cat > %{buildroot}%{_bindir}/%{name} << 'EOF'
#!/bin/sh
exec java --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -jar /usr/share/java/flashalizer.jar "$@"
EOF
chmod 755 %{buildroot}%{_bindir}/%{name}

# icon
install -m 644 img/icon.jpg %{buildroot}%{_datadir}/pixmaps/%{name}.jpg

# desktop file
cat > %{buildroot}%{_datadir}/applications/%{name}.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Flashalizer
Comment=GUI to make .swf files
Exec=/usr/bin/flashalizer
Icon=/usr/share/pixmaps/flashalizer.jpg
Terminal=false
Categories=Utility;Development;
EOF

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/%{name}.desktop

%files
%license LICENSE
%doc INFO
%{_bindir}/%{name}
%{_javadir}/%{name}.jar
%{_datadir}/pixmaps/%{name}.jpg
%{_datadir}/applications/%{name}.desktop

