
off=0
lim=25
if [ -e ~/strel ]; then
	a=`cat ~/strel`
	off="${a%,*}"
	lim="${a#*,}"
fi
echo ${off} ${lim}

a=0
c=0
while :; do
	if [ -z "$1" ]; then
		~/test/ssh/cm 'pgrep -x chromium' > /dev/null
		if [ $? != 0 ]; then
			break
		fi
	fi
	json=$(curl -s "https://api.streamelements.com/kappa/v2/points/5fac0b99b28a1b665e5044c1/alltime?offset=${off}&limit=${lim}")
	if [ -n "$v" ]; then
		echo "$json" | jq
	fi

	# your user index (0-based rank) and points
	idx_points=$(echo "$json" | jq -r '.users | to_entries[] | select(.value.username=="'$(cat ~/twitch_user)'") | "\(.key) \(.value.points)"')
	idx=$(echo "$idx_points" | cut -d' ' -f1)
	b=$(echo "$idx_points" | cut -d' ' -f2)

	# last user points (25th user)
	last=$(echo "$json" | jq '.users[-1].points')

	# difference
	diff=$((b - last))

	if [ $a = $b ]; then
		if [ $c = 1 ]; then
			break
		fi
		c=1
	else
		c=0
		a=$b
	fi

	echo "#$((off+idx)) $b - $last = $diff | $(date)"
	sleep $((5*60))
done
notify-send "Chromium!"
