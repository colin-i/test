set -e
if [ -z "$1" ]; then
	sudo apt update
	sudo apt install ocompiler actionswf wstbld edor sirc torra dicopp audapa
	v=`cat ~/v/ovideo-1/version.txt | sed 's/\./-/'`
	f=ovideo_${v}_i386.deb
	n=~/$f
	wget https://github.com/colin-i/ostream/releases/download/$v/$f -O $n
	sudo dpkg -i $n
elif [ $1 = w ]; then
	w_get () {
		cd ~/a/$1/$2-$3
		u=$(curl https://api.github.com/repos/colin-i/$(cat debian/control | grep "^Homepage" | grep -o [^/]*$)/releases/latest -s)
		if [ -z "$4" ]; then
			f=$2.windows.zip
			u=$(echo $u | jq -r ".assets[] | select(.name == \"$f\") | .browser_download_url")
		else
			u=$(echo $u | jq -r ".assets[] | select(.name | contains(\"$4\")) | .browser_download_url")
			f=$2.pkg.tar.zst
		fi
		if [ -z "${echo}" ]; then
			wget $u -O /mnt/d/Downloads/$f
		else
			echo wget $u -O /mnt/d/Downloads/$f
		fi
		if [ -n "$4" ]; then
			echo pacman -U /d/Downloads/$f
			read
		fi
	}
	if [ -z "$2" ]; then
		w_get o ocompiler 2
		w_get s actionswf 1
		w_get v ovideo 1
		w_get o wstbld 1
		w_get e edor 1 msys
	else
		p_get () {
			echo pip3 install $1
			read
		}
		w_get i sirc 1 mingw-w64
		p_get torra
		p_get dicopp
		p_get audapa
	fi
elif [ $1 = a ]; then
	if [ -z "$p" ]; then
		yay -Sy ocompiler actionswf wstbld edor sirc python-torra python-dicopp python-audapa
	else
		yay -Sy $p
	fi
elif [ $1 = s ]; then
	sudo zypper refresh
	sudo zypper install ocompiler actionswf wstbld edor sirc python313-torra python313-dicopp
else # f
	if [ -n "$a" ]; then
		sudo dnf copr enable colin/project
		sudo dnf install ocompiler actionswf wstbld edor sirc python-torra python-dicopp python-audapa
	else
		sudo dnf upgrade ocompiler actionswf wstbld edor sirc python-torra python-dicopp python-audapa
	fi
fi
