#!/usr/bin/env bash
# keywatch.sh - watch all keyboards for Ctrl+Up / Ctrl+Down and scroll with ydotool.
# Run in a terminal you can see:  sudo ./keywatch.sh
# Needs: sudo apt install libinput-tools

# Must match the socket your ydotoold is using.
#export YDOTOOL_SOCKET=/tmp/.ydotool_socket

# scroll <y>  - sends small wheel events (your command, with the direction as a parameter)
scroll() {
    for i in $(seq 10); do
        ydotool mousemove -w -x 0 -y "$1"
        sleep 0.03
    done
}

ctrl=0
echo "Watching for Ctrl+Up / Ctrl+Down (Ctrl+C to quit)..."

# stdbuf -oL: without it libinput's output is block-buffered in a pipe and events arrive late.
# Line format: -event3   KEYBOARD_KEY   +1.234s   KEY_UP (103) pressed
stdbuf -oL libinput debug-events --show-keycodes |
while read -r _ ev _ key _ state; do
    [[ $ev == KEYBOARD_KEY ]] || continue

    case $key in
        KEY_LEFTCTRL|KEY_RIGHTCTRL)
            [[ $state == pressed ]] && ctrl=1 || ctrl=0
            ;;
        KEY_UP)
            if [[ $state == pressed && $ctrl == 1 ]]; then
                echo "$(date +%T)  Ctrl+Up   -> scroll 1"
                scroll 1
            fi
            ;;
        KEY_DOWN)
            if [[ $state == pressed && $ctrl == 1 ]]; then
                echo "$(date +%T)  Ctrl+Down -> scroll -1"
                scroll -1
            fi
            ;;
    esac
done
